<Window x:Class="Callosotomy.Tray.MonitorWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Callosotomy network monitor" Width="1040" Height="680" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="True"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Vis"/>
  </Window.Resources>

  <Border x:Name="Root" Background="#661C1C22">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Title bar -->
      <DockPanel Margin="16,0,150,0">
        <Image Source="pack://application:,,,/Art/tray-green.png" Width="22" Height="22" VerticalAlignment="Center"/>
        <TextBlock Text="Network monitor" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted2}" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center"/>
      </DockPanel>

      <Grid Grid.Row="1" Margin="12,0,12,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="290"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Apps -->
        <Border CornerRadius="12" Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="10" Margin="0,0,10,0">
          <DockPanel>
            <TextBox DockPanel.Dock="Top" Style="{StaticResource GlassBox}" Tag="Search apps or sites" Margin="0,0,0,8"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search apps or sites"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Apps}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border x:Name="Item" CornerRadius="10" Padding="8,7" Margin="0,0,0,2" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                            Cursor="Hand" MouseLeftButtonUp="OnAppClicked" Tag="{Binding Key}" ToolTip="{Binding Detail}">
                      <DockPanel>
                        <Border Width="28" Height="28" CornerRadius="7" Opacity="0.95">
                          <Border.Background><SolidColorBrush Color="{Binding Accent.Color}" Opacity="0.22"/></Border.Background>
                          <TextBlock Text="{Binding Initials}" Foreground="{Binding Accent}" FontSize="11" FontWeight="SemiBold"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button DockPanel.Dock="Right" Style="{StaticResource AllowSwitch}" Width="34" Height="20" Tag="{Binding AllowByDefault}"
                                IsEnabled="{Binding CanToggle}" Click="OnAppSwitch" VerticalAlignment="Center"
                                AutomationProperties.Name="{Binding Name, StringFormat=Allow {0}}"/>
                        <Border DockPanel.Dock="Right" CornerRadius="8" Background="#14FFFFFF" Padding="6,0" Margin="6,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding CountText}" FontSize="11" Foreground="{StaticResource Muted2}"/>
                        </Border>
                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{StaticResource Muted2}"/>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Item" Property="Background" Value="#1FFFFFFF"/>
                        <Setter TargetName="Item" Property="BorderBrush" Value="#33FFFFFF"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- Selected app -->
        <Border Grid.Column="1" CornerRadius="12" Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="16,14"
                Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
          <DockPanel DataContext="{Binding}">
            <!-- Header -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
              <Border Width="40" Height="40" CornerRadius="10">
                <Border.Background><SolidColorBrush Color="{Binding Selected.Accent.Color}" Opacity="0.22"/></Border.Background>
                <TextBlock Text="{Binding Selected.Initials}" Foreground="{Binding Selected.Accent}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Selected.DefaultText}" Foreground="{StaticResource Muted2}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Style="{StaticResource AllowSwitch}" Tag="{Binding Selected.AllowByDefault}" IsEnabled="{Binding Selected.CanToggle}" Click="OnSelectedSwitch"
                        AutomationProperties.Name="Allow this app by default"/>
                <Button Style="{StaticResource Chip}" Content="⋯" FontSize="14" Margin="10,0,0,0" Padding="10,1" Click="OnMore" AutomationProperties.Name="More options">
                  <Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Copy as PowerShell commands" Click="OnCopyPowerShell"/>
                      <MenuItem Header="Remove all rules for this app" Click="OnRemoveAll"/>
                    </ContextMenu>
                  </Button.ContextMenu>
                </Button>
              </StackPanel>
              <StackPanel Margin="12,0,10,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Selected.Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Selected.Detail}" FontSize="11.5" Foreground="{StaticResource Muted2}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>

            <!-- Message -->
            <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" Foreground="#FF9CFFC4" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>

            <!-- Add rule -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" IsEnabled="{Binding CanEditSelected}">
              <TextBlock Text="ADD RULE" FontSize="11" Foreground="{StaticResource Muted2}" Margin="0,0,0,6"/>
              <Border CornerRadius="10" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="10">
                <StackPanel>
                  <WrapPanel Margin="0,0,0,8">
                    <RadioButton x:Name="FAllow" Style="{StaticResource Segment}" GroupName="act" Content="Allow" IsChecked="True"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="act" Content="Block" Margin="0,0,14,0"/>
                    <RadioButton x:Name="FOut" Style="{StaticResource Segment}" GroupName="dir" Content="Outgoing" IsChecked="True"/>
                    <RadioButton x:Name="FIn" Style="{StaticResource Segment}" GroupName="dir" Content="Incoming"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="dir" Content="Both" Margin="0,0,14,0"/>
                    <RadioButton x:Name="FTcp" Style="{StaticResource Segment}" GroupName="proto" Content="TCP"/>
                    <RadioButton x:Name="FUdp" Style="{StaticResource Segment}" GroupName="proto" Content="UDP"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="proto" Content="Any" IsChecked="True"/>
                  </WrapPanel>
                  <WrapPanel>
                    <RadioButton x:Name="FAnywhere" Style="{StaticResource Segment}" GroupName="dest" Content="Anywhere" IsChecked="True"/>
                    <RadioButton x:Name="FInternet" Style="{StaticResource Segment}" GroupName="dest" Content="Internet"/>
                    <RadioButton x:Name="FLocal" Style="{StaticResource Segment}" GroupName="dest" Content="Local network"/>
                    <RadioButton x:Name="FDomain" Style="{StaticResource Segment}" GroupName="dest" Content="Domain"/>
                    <RadioButton x:Name="FAddress" Style="{StaticResource Segment}" GroupName="dest" Content="Address" Margin="0,0,10,0"/>
                    <TextBox x:Name="FValue" Style="{StaticResource GlassBox}" Width="170" Tag="example.com or 1.2.3.4" Margin="0,0,8,0" AutomationProperties.Name="Domain or address"/>
                    <TextBox x:Name="FPorts" Style="{StaticResource GlassBox}" Width="130" Tag="Ports, e.g. 443" Margin="0,0,8,0" AutomationProperties.Name="Ports"/>
                    <Button Style="{StaticResource Chip}" Content="Add rule" Padding="14,5" Click="OnAddRule"/>
                  </WrapPanel>
                  <TextBlock x:Name="FError" Foreground="#FFFF8F87" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Rules + connections -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="RULES · MOST SPECIFIC WINS" FontSize="11" Foreground="{StaticResource Muted2}" Margin="0,0,0,6"/>
                <Border CornerRadius="10" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                  <StackPanel>
                    <ItemsControl ItemsSource="{Binding Rules}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border BorderBrush="#12FFFFFF" BorderThickness="0,0,0,1" Padding="10,7">
                            <DockPanel>
                              <Border Style="{StaticResource Pill}" Tag="{Binding IsAllow}" Width="56">
                                <TextBlock Text="{Binding ActionText}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                              </Border>
                              <Button DockPanel.Dock="Right" Style="{StaticResource Chip}" Content="✕" Padding="7,1" Margin="8,0,0,0" Click="OnDeleteRule"
                                      IsEnabled="{Binding Editable}" AutomationProperties.Name="Delete rule"/>
                              <Button DockPanel.Dock="Right" Style="{StaticResource OnSwitch}" Tag="{Binding Enabled}" Click="OnToggleRule"
                                      IsEnabled="{Binding Editable}" AutomationProperties.Name="Rule on or off"/>
                              <TextBlock Margin="12,0,8,0" VerticalAlignment="Center" FontSize="12.5" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding DirectionText, Mode=OneWay}" Foreground="{StaticResource Muted2}"/>
                                <Run Text="  "/><Run Text="{Binding ProtocolText, Mode=OneWay}" Foreground="{StaticResource Muted2}"/>
                                <Run Text="  "/><Run Text="{Binding PortText, Mode=OneWay}" Foreground="{StaticResource Muted2}"/>
                                <Run Text="   "/><Run Text="{Binding DestinationText, Mode=OneWay}"/>
                              </TextBlock>
                            </DockPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="10,7">
                      <Border Style="{StaticResource Pill}" Tag="{Binding Selected.AllowByDefault}" Width="56">
                        <TextBlock FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Text" Value="Block"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Selected.AllowByDefault}" Value="True"><Setter Property="Text" Value="Allow"/></DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Border>
                      <TextBlock Text="Everything else (app default)" FontStyle="Italic" Foreground="{StaticResource Muted2}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                  </StackPanel>
                </Border>

                <TextBlock Text="LIVE CONNECTIONS" FontSize="11" Foreground="{StaticResource Muted2}" Margin="0,14,0,6"/>
                <Border CornerRadius="10" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                  <ItemsControl ItemsSource="{Binding SelectedConnections}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#12FFFFFF" BorderThickness="0,0,0,1" Padding="10,6" Opacity="{Binding RowOpacity}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="60"/>
                              <ColumnDefinition Width="170"/>
                              <ColumnDefinition Width="70"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Destination}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       ToolTip="{Binding Info.RemoteAddress}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Port}" FontSize="12" Foreground="{StaticResource Muted2}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Where}" FontSize="12" Foreground="{StaticResource Muted2}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center">
                              <TextBlock.ToolTip>
                                <TextBlock>
                                  <Run Text="{Binding Why, Mode=OneWay}"/><LineBreak/><Run Text="Last activity: "/><Run Text="{Binding Activity, Mode=OneWay}"/>
                                </TextBlock>
                              </TextBlock.ToolTip>
                            </TextBlock>
                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                              <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                  <Style.Triggers>
                                    <MultiDataTrigger>
                                      <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding CanAct}" Value="True"/>
                                        <Condition Binding="{Binding HasRemote}" Value="True"/>
                                      </MultiDataTrigger.Conditions>
                                      <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </StackPanel.Style>
                              <Button Style="{StaticResource Chip}" Content="Allow only this" Click="OnAllowOnly"/>
                              <Button Style="{StaticResource Chip}" Content="Block port" Click="OnBlockPort"/>
                              <Button Style="{StaticResource Chip}" Content="Block site" Click="OnBlockSite"/>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
