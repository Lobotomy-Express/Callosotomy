<Window x:Class="Callosotomy.Tray.PaneWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Callosotomy.Tray"
        Title="Callosotomy" Width="380" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Border x:Name="Root" Background="#661C1C22" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="8" Padding="20">
    <Border.RenderTransform><TranslateTransform x:Name="SlideIn"/></Border.RenderTransform>
    <StackPanel>
      <!-- Header -->
      <DockPanel Margin="4,2,4,14">
        <local:BrainArt Width="30" Height="30" Mode="{Binding Mode}" Reachable="{Binding Reachable}" Bypassed="{Binding Bypassed}"/>
        <TextBlock Text="Callosotomy" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
        <TextBlock Text="Ctrl + Alt + K" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"
                   ToolTip="Cuts everything instantly from anywhere"/>
      </DockPanel>

      <!-- Status card -->
      <Border CornerRadius="20" Padding="16" Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Margin="0,0,0,14">
        <DockPanel>
          <Border Width="56" Height="56" CornerRadius="28" Background="{Binding AccentTint}" VerticalAlignment="Center">
            <local:BrainArt Width="48" Height="48" Mode="{Binding Mode}" Reachable="{Binding Reachable}" Bypassed="{Binding Bypassed}"/>
          </Border>
          <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Mode rows -->
      <Button Style="{StaticResource Row}" Tag="{Binding InternetOn}" IsEnabled="{Binding Reachable}" Click="OnInternet" Margin="0,0,0,8"
              AutomationProperties.Name="Sever internet">
        <DockPanel>
          <Border Style="{StaticResource IconDisc}" Tag="{Binding InternetOn}">
            <Path Style="{StaticResource IconStroke}" Data="M12,3 A9,9 0 1 1 11.99,3 Z M3,12 H21 M12,3 C16,7 16,17 12,21 M12,3 C8,7 8,17 12,21"/>
          </Border>
          <ContentControl Style="{StaticResource Switch}" Tag="{Binding InternetOn}" Foreground="{StaticResource SevereRed}" DockPanel.Dock="Right"/>
          <StackPanel Margin="14,0,10,0" VerticalAlignment="Center">
            <TextBlock Text="Internet" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="Cut traffic to the outside world" FontSize="12.5" Foreground="{StaticResource TextMuted}"/>
          </StackPanel>
        </DockPanel>
      </Button>

      <Button Style="{StaticResource Row}" Tag="{Binding LocalOn}" IsEnabled="{Binding Reachable}" Click="OnLocal" Margin="0,0,0,8"
              AutomationProperties.Name="Sever local network">
        <DockPanel>
          <Border Style="{StaticResource IconDisc}" Tag="{Binding LocalOn}">
            <Path Style="{StaticResource IconStroke}" Data="M10,3 H14 V8 H10 Z M4,16 H8 V21 H4 Z M16,16 H20 V21 H16 Z M12,8 V12 M6,16 V12 H18 V16"/>
          </Border>
          <ContentControl Style="{StaticResource Switch}" Tag="{Binding LocalOn}" Foreground="{StaticResource SevereRed}" DockPanel.Dock="Right"/>
          <StackPanel Margin="14,0,10,0" VerticalAlignment="Center">
            <TextBlock Text="Local network" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="Stop spread to other devices" FontSize="12.5" Foreground="{StaticResource TextMuted}"/>
          </StackPanel>
        </DockPanel>
      </Button>

      <Button Style="{StaticResource Row}" Tag="{Binding AllOn}" IsEnabled="{Binding Reachable}" Click="OnAll" Margin="0,0,0,14"
              AutomationProperties.Name="Sever everything">
        <DockPanel>
          <Border Style="{StaticResource IconDisc}" Tag="{Binding AllOn}">
            <Path Style="{StaticResource IconStroke}" Data="M12,3 L20,6 V12 C20,17 16.5,20 12,21 C7.5,20 4,17 4,12 V6 Z M9,12 L11,14 L15,10"/>
          </Border>
          <ContentControl Style="{StaticResource Switch}" Tag="{Binding AllOn}" Foreground="{StaticResource SevereRed}" DockPanel.Dock="Right"/>
          <StackPanel Margin="14,0,10,0" VerticalAlignment="Center">
            <TextBlock Text="Everything" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="Full isolation, both directions" FontSize="12.5" Foreground="{StaticResource TextMuted}"/>
          </StackPanel>
        </DockPanel>
      </Button>

      <!-- Health -->
      <Border CornerRadius="18" Background="#0FFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Margin="0,0,0,14">
        <StackPanel>
          <DockPanel Margin="14,12">
            <TextBlock Text="Tamper check" FontSize="13" Foreground="{StaticResource TextMuted}"/>
            <TextBlock Text="{Binding TamperText}" Foreground="{Binding TamperBrush}" FontSize="13" FontWeight="Medium" HorizontalAlignment="Right"/>
          </DockPanel>
          <Border Height="1" Background="#1AFFFFFF"/>
          <DockPanel Margin="14,12">
            <TextBlock Text="Protection service" FontSize="13" Foreground="{StaticResource TextMuted}"/>
            <TextBlock Text="{Binding ServiceText}" Foreground="{Binding ServiceBrush}" FontSize="13" FontWeight="Medium" HorizontalAlignment="Right"/>
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- Floating button -->
      <Button Style="{StaticResource Row}" Click="OnToggleOrb" IsEnabled="{Binding OrbToggleEnabled}" Margin="0,0,0,14"
              AutomationProperties.Name="Show floating button">
        <DockPanel>
          <ContentControl Style="{StaticResource Switch}" Tag="{Binding ShowOrb}" Foreground="{StaticResource LiveGreen}" DockPanel.Dock="Right"/>
          <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
            <TextBlock Text="Floating button" FontSize="13" FontWeight="Medium"/>
            <TextBlock Text="Optional panic button on the desktop" FontSize="12" Foreground="{StaticResource TextMuted}"/>
          </StackPanel>
        </DockPanel>
      </Button>

      <Button Style="{StaticResource Primary}" Content="Restore all connections" Click="OnRestore" IsEnabled="{Binding Blocked}"/>
    </StackPanel>
  </Border>
</Window>
